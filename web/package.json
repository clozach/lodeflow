{
  "name": "lodeflow",
  "version": "0.1.0",
  "description": "Self-organizing flow diagrams for the web: a Rust/WASM layout engine that follows the ten Flying Logic layout rules, wrapped in a <lode-flow> web component.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/lode-flow.js",
  "module": "./dist/lode-flow.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lode-flow.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./iife": "./dist/lode-flow.iife.js",
    "./theditor": {
      "types": "./dist/types/theditor/index.d.ts",
      "import": "./dist/theditor.js"
    },
    "./theditor/iife": "./dist/theditor.iife.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/lode-flow.js",
    "./dist/lode-flow.iife.js",
    "./dist/theditor.js",
    "./dist/theditor.iife.js",
    "./src/theditor/vendor/field-core/field-core.js",
    "./src/theditor/vendor/field-core/icons.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/model.mjs && node test/loose.mjs && node test/reverse.mjs && node test/fixture-controls.mjs && node test/geometry.mjs && node test/history.mjs && node test/limits.mjs && node test/placement.mjs && node test/presentation.mjs && node test/controls.mjs && node test/forks.mjs && node test/child-reverse.mjs && node test/copy-paste.mjs && node test/rotation.mjs && node test/e2e.mjs && node test/theditor.mjs && node test/theditor-magnets.mjs",
    "prebuild": "node ../scripts/check-theditor-vendor.mjs",
    "pretest": "node ../scripts/check-theditor-vendor.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiptap/core": "3.10.8",
    "@tiptap/extension-blockquote": "3.10.8",
    "@tiptap/extension-bold": "3.10.8",
    "@tiptap/extension-code": "3.10.8",
    "@tiptap/extension-code-block": "3.10.8",
    "@tiptap/extension-document": "3.10.8",
    "@tiptap/extension-hard-break": "3.10.8",
    "@tiptap/extension-heading": "3.10.8",
    "@tiptap/extension-horizontal-rule": "3.10.8",
    "@tiptap/extension-italic": "3.10.8",
    "@tiptap/extension-link": "3.10.8",
    "@tiptap/extension-list": "3.10.8",
    "@tiptap/extension-paragraph": "3.10.8",
    "@tiptap/extension-text": "3.10.8",
    "@tiptap/extensions": "3.10.8",
    "@tiptap/pm": "3.10.8",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
